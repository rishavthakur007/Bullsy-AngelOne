# Bullsy needs no settings to run: all market data comes from the files in data/.
# These are optional. Set them only on the host (Render: service > Environment),
# never in GitHub and never in chat.

# Password for the owner-only page at /admin (any username). Leave empty to switch /admin off.
ADMIN_PASSWORD=

# AI Coach button (each use costs money; limited per visitor). Leave empty to hide it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
