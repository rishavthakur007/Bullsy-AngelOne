# These settings belong ONLY on the backend host (Render: service > Environment).
# For local development copy this file to .env. Never commit real values, never put
# them in public/, and never share them in chat or screenshots.

# --- Angel One SmartAPI (required: Bullsy gets all its market data here) ---
# The server signs in by itself with these four values. Together they are a full
# login to the Angel One account.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# The key shown under the QR code when you enable TOTP (not the 6-digit code).
ANGEL_TOTP_SECRET=

# --- Admin page ---
# Password for the owner-only page at /admin (any username). Use a long one.
ADMIN_PASSWORD=

# --- Data mode ---
# 1 = real data one trading day late, labelled DELAYED (default).
# 0 = real time while the market is open, refreshed every few seconds.
BULLSY_DATA_DELAY_DAYS=1

# --- Optional ---
# Only if the frontend is hosted on a different address (Netlify / Vercel).
FRONTEND_ORIGIN=
# AI Coach button (each use costs money; limited per visitor).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# BULLSY_POLL_INTERVAL_MS=5000
# COACH_LIMIT_PER_IP_PER_HOUR=5
# COACH_LIMIT_PER_DAY=300
# Override an index token, as EXCHANGE|TOKEN:
# ANGEL_TOKEN_NIFTYIT=NSE|99926008
